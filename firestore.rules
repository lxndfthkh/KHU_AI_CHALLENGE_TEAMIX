rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(gid) {
      return signedIn() && exists(/databases/$(database)/documents/memberships/$(gid + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/memberships/$(gid + '_' + request.auth.uid)).data.status == 'approved';
    }
    function admin(gid) {
      return member(gid) && get(/databases/$(database)/documents/memberships/$(gid + '_' + request.auth.uid)).data.role == 'admin';
    }
    function activity(aid) { return get(/databases/$(database)/documents/activities/$(aid)).data; }
    function participant(aid) {
      return signedIn() && exists(/databases/$(database)/documents/registrations/$(aid + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/registrations/$(aid + '_' + request.auth.uid)).data.status == 'submitted';
    }
    function validProfile(d) {
      return d.keys().hasAll(['displayName','createdAt','updatedAt'])
        && d.keys().hasOnly(['displayName','createdAt','updatedAt'])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // createGroup without a server: one batch writes groups/{gid} and the
    // creator's approved admin membership; each rule requires the other.
    function shortString(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    function validCategories(c) {
      return c is list && c.size() <= 2
        && (c.size() < 1 || shortString(c[0], 20))
        && (c.size() < 2 || shortString(c[1], 20));
    }
    function validNewGroup(d) {
      return d.keys().hasOnly(['name','description','categories','ownerId','themeColor','status','createdAt','updatedAt'])
        && d.keys().hasAll(['name','description','categories','ownerId','themeColor','status','createdAt','updatedAt'])
        && shortString(d.name, 40) && shortString(d.description, 100) && validCategories(d.categories)
        && d.ownerId == request.auth.uid && d.themeColor in ['mint','peach','lilac'] && d.status == 'active'
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function validCreatorMembership(id, d) {
      return d.keys().hasOnly(['groupId','userId','displayName','role','status','createdAt','updatedAt'])
        && d.keys().hasAll(['groupId','userId','displayName','role','status','createdAt','updatedAt'])
        && d.groupId is string && id == d.groupId + '_' + request.auth.uid
        && d.userId == request.auth.uid && shortString(d.displayName, 40)
        && d.role == 'admin' && d.status == 'approved'
        && d.createdAt == request.time && d.updatedAt == request.time
        // Only for a group created in this same batch, never an existing one.
        && !exists(/databases/$(database)/documents/groups/$(d.groupId))
        && existsAfter(/databases/$(database)/documents/groups/$(d.groupId))
        && getAfter(/databases/$(database)/documents/groups/$(d.groupId)).data.ownerId == request.auth.uid;
    }
    match /groups/{gid} {
      allow read: if member(gid);
      allow create: if signedIn() && !gid.matches('.*_.*') && validNewGroup(request.resource.data)
        && existsAfter(/databases/$(database)/documents/memberships/$(gid + '_' + request.auth.uid));
      allow update, delete: if false;
    }
    match /memberships/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin(resource.data.groupId)
        || (member(resource.data.groupId) && resource.data.status == 'approved'));
      allow create: if signedIn() && validCreatorMembership(id, request.resource.data);
      allow update, delete: if false;
    }
    match /invitations/{id} { allow read, write: if false; }
    match /activities/{aid} {
      allow read: if member(resource.data.groupId);
      allow write: if false;
      match /settings/{id} {
        allow read: if admin(activity(aid).groupId);
        allow write: if false;
      }
      match /questions/{id} {
        allow read: if member(activity(aid).groupId);
        allow write: if false;
      }
      match /feedbackSummary/{id} {
        allow read: if admin(activity(aid).groupId);
        allow write: if false;
      }
    }
    match /registrations/{id} {
      allow read: if signedIn() && member(resource.data.groupId)
        && (resource.data.userId == request.auth.uid || admin(resource.data.groupId));
      allow write: if false;
    }
    match /drafts/{id} {
      allow read: if admin(resource.data.groupId);
      allow write: if false;
    }
    match /publications/{id} {
      allow read: if admin(resource.data.groupId);
      allow write: if false;
    }
    match /teamViews/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid
        && member(resource.data.groupId) && participant(resource.data.activityId);
      allow write: if false;
    }
    match /feedback/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid && member(resource.data.groupId);
      allow write: if false;
    }
    match /placementPreferences/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }
    // Learning consent (편성학습_v3 12장). Written only by the setLearningConsent command.
    match /consents/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /appConfig/{id} { allow read: if signedIn(); allow write: if false; }
    match /_schema/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
