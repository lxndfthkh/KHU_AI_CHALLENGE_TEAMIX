# Cloud Run job for learning stages (편성학습_v3 6장~). Run on a schedule, e.g. hourly:
#   python -m learning.extract   -> extracts every closed activity that is new or changed
FROM python:3.12-slim
WORKDIR /app
COPY requirements-stage3.txt .
RUN pip install --no-cache-dir -r requirements-stage3.txt
COPY . .
USER 65532:65532
CMD ["python", "-m", "learning.extract"]
